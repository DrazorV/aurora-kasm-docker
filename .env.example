# Absolute host path containing the shared Aurora data.
AURORA_DATA_PATH=/srv/aurora

# Prebuilt image to run (override if you publish under a different owner/tag).
AURORA_IMAGE=ghcr.io/drazorv/aurora-kasm:latest

# Bind address and host port exposed to the reverse proxy.
AURORA_BIND_IP=0.0.0.0
AURORA_PORT=8444

# Runtime locale and timezone.
TZ=Europe/Athens
